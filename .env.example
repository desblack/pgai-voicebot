# Twilio — console.twilio.com dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The number you purchased. This exact string is the caller ID for every
# test call, and it is what goes on the submission form. E.164 format.
TWILIO_FROM_NUMBER=+1XXXXXXXXX

# The number you want to call for testing. This is the number you will
PGAI_TEST_NUMBER=+180543980XX

# OpenAI — platform.openai.com. Needs Realtime model access.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public HTTPS tunnel to your local server (ngrok). No trailing slash.
# Changes every ngrok restart on the free tier.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.dev

# Guardrails
MAX_CALLS_PER_RUN=15
MAX_CALL_DURATION_SECONDS=240

# Optional override if the Realtime model name changes
OPENAI_REALTIME_MODEL=gpt-realtime-2.1